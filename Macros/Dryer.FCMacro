# FreeCAD 1.1.1 Spiral Tunnel Creator - Clean PartDesign Method
# Uses proper PartDesign workflow with Additive Helix

import FreeCAD
import Part
import Sketcher
import PartDesign
import math

def create_spiral_tunnel_module():
    """
    Create filament dryer module using proper PartDesign Additive Helix method
    """
    
    # Parameters
    OUTER_DIAMETER = 150.0      # mm - module outer diameter
    CENTER_HOLE_DIAMETER = 35.0 # mm - central heating core
    MODULE_HEIGHT = 50.0        # mm - module height
    NUM_LOOPS = 10             # number of spiral loops
    TUNNEL_DIAMETER = 3.0      # mm - tunnel for 1.75mm filament + clearance
    WALL_THICKNESS = 5.0       # mm - minimum wall thickness on all sides
    
    # Calculated parameters
    # Spiral radius must account for tunnel radius to maintain wall thickness
    SPIRAL_RADIUS = (OUTER_DIAMETER/2) - WALL_THICKNESS - (TUNNEL_DIAMETER/2)
    # Height must account for tunnel diameter at top and bottom
    spiral_height = MODULE_HEIGHT - (2 * WALL_THICKNESS) - TUNNEL_DIAMETER
    pitch = spiral_height / NUM_LOOPS  # Height per loop
    z_offset = WALL_THICKNESS + (TUNNEL_DIAMETER/2)  # Start spiral center up from bottom
    
    print(f"FreeCAD Spiral Tunnel Creator v2.1")
    print(f"Creating spiral tunnel module using PartDesign Additive Helix:")
    print(f"  Tunnel diameter: {TUNNEL_DIAMETER}mm")
    print(f"  Wall thickness: {WALL_THICKNESS}mm")
    print(f"  Spiral radius: {SPIRAL_RADIUS}mm") 
    print(f"  Spiral height: {spiral_height}mm")
    print(f"  Pitch: {pitch:.1f}mm")
    print(f"  Total height: {MODULE_HEIGHT}mm")
    print(f"  Turns: {NUM_LOOPS}")
    
    # Create document
    try:
        doc = FreeCAD.getDocument("FilamentDryer")
        # Clear existing document - commented out for development
        # for obj in doc.Objects:
        #     doc.removeObject(obj.Name)
    except:
        doc = FreeCAD.newDocument("FilamentDryer")
    
    # Step 1: Create PartDesign Body for tunnel
    body = doc.addObject('PartDesign::Body', 'TunnelBody')
    
    # Step 2: Create sketch for circular profile
    sketch = body.newObject('Sketcher::SketchObject', 'CircleProfile')
    
    # Position the sketch at the bottom with wall thickness offset
    sketch.Placement = FreeCAD.Placement(
        FreeCAD.Vector(0, 0, z_offset),
        FreeCAD.Rotation(0, 0, 0)
    )
    
    # The profile should be a circle at the spiral radius on the XY plane
    # For a helix around Z-axis, profile should be offset from origin
    circle = sketch.addGeometry(Part.Circle(
        FreeCAD.Vector(SPIRAL_RADIUS, 0, 0),  # Center at spiral radius
        FreeCAD.Vector(0, 0, 1),              # Normal to XY plane
        TUNNEL_DIAMETER/2                      # Radius of tunnel
    ), False)  # False = not construction geometry
    
    # Add constraints to fully define the circle
    sketch.addConstraint(Sketcher.Constraint('Radius', circle, TUNNEL_DIAMETER/2))
    
    # Constrain the center point position
    center_point = sketch.getPoint(circle, 3)  # 3 = center point
    sketch.addConstraint(Sketcher.Constraint('DistanceX', -1, 1, circle, 3, SPIRAL_RADIUS))
    sketch.addConstraint(Sketcher.Constraint('DistanceY', -1, 1, circle, 3, 0))
    
    doc.recompute()
    print("✓ Created circular profile sketch at spiral radius")
    
    # Step 3: Create Additive Helix
    helix_created = False
    try:
        helix = body.newObject("PartDesign::AdditiveHelix", "SpiralTunnel")
        helix.Profile = sketch
        
        # Set helix parameters
        helix.Mode = 0  # 0 = pitch-height mode
        helix.Pitch = pitch
        helix.Height = spiral_height  # Use reduced height to maintain wall thickness
        helix.Turns = NUM_LOOPS
        helix.LeftHanded = False
        helix.Reversed = False
        
        # Set reference axis to Z-axis
        helix.ReferenceAxis = (body.Origin.OriginFeatures[2], [''])  # Z-axis
        
        doc.recompute()
        
        # Check if helix created properly
        if hasattr(helix, 'Shape') and helix.Shape.isValid():
            print("✓ Created spiral tunnel using PartDesign Additive Helix")
            helix_created = True
            
            # Set visualization
            if hasattr(helix, 'ViewObject'):
                helix.ViewObject.ShapeColor = (1.0, 0.0, 1.0)  # Magenta
                helix.ViewObject.Transparency = 30
        else:
            print("❌ Helix shape is invalid")
            
    except Exception as e:
        print(f"❌ Additive Helix failed: {e}")
    
    # Step 4: Create main cylinder with center hole
    # Position cylinder centered on origin
    outer_cylinder = Part.makeCylinder(
        OUTER_DIAMETER/2, 
        MODULE_HEIGHT,
        FreeCAD.Vector(0, 0, 0)
    )
    
    center_hole = Part.makeCylinder(
        CENTER_HOLE_DIAMETER/2, 
        MODULE_HEIGHT + 2,
        FreeCAD.Vector(0, 0, -1)
    )
    
    main_shape = outer_cylinder.cut(center_hole)
    
    # Step 5: Create tangential entry and exit tunnels
    # Calculate entry point (start of helix)
    entry_angle = 0
    entry_x = SPIRAL_RADIUS * math.cos(entry_angle)
    entry_y = SPIRAL_RADIUS * math.sin(entry_angle)
    entry_z = z_offset
    
    # Entry tunnel - tangential to spiral at start
    # Tangent direction at entry: perpendicular to radius, in XY plane
    entry_tangent_x = -math.sin(entry_angle)  # Derivative of cos
    entry_tangent_y = math.cos(entry_angle)   # Derivative of sin
    entry_tangent_z = pitch / (2 * math.pi * SPIRAL_RADIUS)  # Vertical component based on pitch
    
    # Normalize the tangent vector
    entry_tangent = FreeCAD.Vector(entry_tangent_x, entry_tangent_y, entry_tangent_z).normalize()
    
    # Calculate required tunnel length to clear the cylinder
    # The tunnel needs to travel from SPIRAL_RADIUS to beyond OUTER_DIAMETER/2
    # Account for the tangential angle and add 20mm for obvious exit
    distance_to_wall = OUTER_DIAMETER/2 - SPIRAL_RADIUS
    # Since we're going tangentially, we need more length to actually clear the wall
    # For a tangent starting at radius R, the distance to clear radius R_outer is approximately:
    # distance = sqrt((R_outer)^2 - R^2) for pure tangent, but we have a slight angle
    clearance_length = math.sqrt((OUTER_DIAMETER/2)**2 - (SPIRAL_RADIUS)**2) * 1.2  # 1.2 safety factor
    tunnel_length = clearance_length + 20.0  # Add 20mm for obvious exit
    
    # Create entry tunnel extending backwards from entry point
    entry_tunnel = Part.makeCylinder(
        TUNNEL_DIAMETER/2,
        tunnel_length,
        FreeCAD.Vector(entry_x - entry_tangent.x * tunnel_length,
                      entry_y - entry_tangent.y * tunnel_length,
                      entry_z - entry_tangent.z * tunnel_length),
        entry_tangent
    )
    
    # Calculate exit point (end of helix)
    exit_angle = 2 * math.pi * NUM_LOOPS  # Total rotation in radians
    exit_x = SPIRAL_RADIUS * math.cos(exit_angle)
    exit_y = SPIRAL_RADIUS * math.sin(exit_angle)
    exit_z = z_offset + spiral_height
    
    # Exit tunnel - tangential to spiral at end
    exit_tangent_x = -math.sin(exit_angle)
    exit_tangent_y = math.cos(exit_angle)
    exit_tangent_z = pitch / (2 * math.pi * SPIRAL_RADIUS)
    
    # Normalize the exit tangent vector
    exit_tangent = FreeCAD.Vector(exit_tangent_x, exit_tangent_y, exit_tangent_z).normalize()
    
    # Create exit tunnel extending forward from exit point
    exit_tunnel = Part.makeCylinder(
        TUNNEL_DIAMETER/2,
        tunnel_length,
        FreeCAD.Vector(exit_x, exit_y, exit_z),
        exit_tangent
    )
    
    print(f"✓ Created tangential entry tunnel at angle 0° at height {entry_z:.1f}mm")
    print(f"✓ Created tangential exit tunnel at angle {math.degrees(exit_angle):.1f}° at height {exit_z:.1f}mm")
    print(f"  Calculated clearance: {clearance_length:.1f}mm + 20mm extension = {tunnel_length:.1f}mm total")
    
    # Step 6: Create final part
    if helix_created and body.Shape.isValid():
        try:
            # Combine helix tunnel with entry and exit tunnels
            tunnel_system = body.Shape.fuse([entry_tunnel, exit_tunnel])
            
            # Cut the complete tunnel system from main cylinder
            final_shape = main_shape.cut(tunnel_system)
            
            final_obj = doc.addObject("Part::Feature", "ModuleWithTunnel")
            final_obj.Shape = final_shape
            final_obj.Label = "Filament Dryer Module"
            
            # Set visualization
            if hasattr(final_obj, 'ViewObject'):
                final_obj.ViewObject.Transparency = 50
                final_obj.ViewObject.ShapeColor = (0.8, 0.8, 0.9)
            
            # Hide the body since we have the final part
            body.ViewObject.Visibility = False
            
            print("✓ Successfully cut spiral tunnel with entry/exit ports from main cylinder")
            
        except Exception as e:
            print(f"❌ Cut operation failed: {e}")
            print("Creating main cylinder without tunnel")
            
            final_obj = doc.addObject("Part::Feature", "MainCylinder")
            final_obj.Shape = main_shape
            final_obj.Label = "Main Cylinder (No Tunnel)"
    else:
        # If helix failed, just create the main cylinder
        print("Creating main cylinder without tunnel")
        
        final_obj = doc.addObject("Part::Feature", "MainCylinder")
        final_obj.Shape = main_shape
        final_obj.Label = "Main Cylinder (No Tunnel)"
        
        if hasattr(final_obj, 'ViewObject'):
            final_obj.ViewObject.Transparency = 50
            final_obj.ViewObject.ShapeColor = (0.8, 0.8, 0.9)
    
    # Final recompute
    doc.recompute()
    
    # Try to fit view
    try:
        import FreeCADGui
        FreeCADGui.SendMsgToActiveView("ViewFit")
        FreeCADGui.activeDocument().activeView().viewAxonometric()
    except:
        pass
    
    print("\n✓ Module creation complete!")
    if helix_created:
        print("  - Spiral tunnel successfully integrated")
    else:
        print("  - Main cylinder created (tunnel creation failed)")
    print(f"  - Dimensions: {OUTER_DIAMETER}mm × {MODULE_HEIGHT}mm")
    print(f"  - Center hole: {CENTER_HOLE_DIAMETER}mm")
    
    return final_obj

# Alternative method using Part workbench if PartDesign fails
def create_spiral_tunnel_part_method():
    """
    Alternative method using Part workbench for creating spiral tunnel
    """
    print("\nTrying alternative Part workbench method...")
    
    # Parameters
    OUTER_DIAMETER = 150.0
    CENTER_HOLE_DIAMETER = 35.0
    MODULE_HEIGHT = 50.0
    NUM_LOOPS = 10
    TUNNEL_DIAMETER = 3.0
    WALL_THICKNESS = 5.0
    
    # Calculated parameters
    # Spiral radius must account for tunnel radius to maintain wall thickness
    SPIRAL_RADIUS = (OUTER_DIAMETER/2) - WALL_THICKNESS - (TUNNEL_DIAMETER/2)
    # Height must account for tunnel diameter at top and bottom
    spiral_height = MODULE_HEIGHT - (2 * WALL_THICKNESS) - TUNNEL_DIAMETER
    pitch = spiral_height / NUM_LOOPS
    z_offset = WALL_THICKNESS + (TUNNEL_DIAMETER/2)
    
    try:
        doc = FreeCAD.getDocument("FilamentDryer")
        # Clear existing document - commented out for development
        # for obj in doc.Objects:
        #     doc.removeObject(obj.Name)
    except:
        doc = FreeCAD.newDocument("FilamentDryer")
    
    # Create helix curve starting at z_offset
    helix_curve = Part.makeHelix(pitch, spiral_height, SPIRAL_RADIUS)
    helix_curve.Placement = FreeCAD.Placement(
        FreeCAD.Vector(0, 0, z_offset),
        FreeCAD.Rotation(0, 0, 0)
    )
    
    # Create circle profile
    circle = Part.makeCircle(TUNNEL_DIAMETER/2)
    circle.Placement = FreeCAD.Placement(
        FreeCAD.Vector(SPIRAL_RADIUS, 0, z_offset),
        FreeCAD.Rotation(0, 90, 0)
    )
    
    # Create wire and sweep
    wire = Part.Wire(circle)
    tunnel_shape = wire.makePipeShell([helix_curve], True, True)
    
    # Create main cylinder
    outer_cylinder = Part.makeCylinder(OUTER_DIAMETER/2, MODULE_HEIGHT)
    center_hole = Part.makeCylinder(CENTER_HOLE_DIAMETER/2, MODULE_HEIGHT + 2,
                                   FreeCAD.Vector(0, 0, -1))
    main_shape = outer_cylinder.cut(center_hole)
    
    # Create tangential entry and exit tunnels
    entry_angle = 0
    entry_x = SPIRAL_RADIUS * math.cos(entry_angle)
    entry_y = SPIRAL_RADIUS * math.sin(entry_angle)
    entry_z = z_offset
    
    # Entry tangent direction
    entry_tangent_x = -math.sin(entry_angle)
    entry_tangent_y = math.cos(entry_angle)
    entry_tangent_z = pitch / (2 * math.pi * SPIRAL_RADIUS)
    entry_tangent = FreeCAD.Vector(entry_tangent_x, entry_tangent_y, entry_tangent_z).normalize()
    
    # Calculate proper clearance length
    clearance_length = math.sqrt((OUTER_DIAMETER/2)**2 - (SPIRAL_RADIUS)**2) * 1.2
    tunnel_length = clearance_length + 20.0  # Add 20mm for obvious exit
    
    entry_tunnel = Part.makeCylinder(
        TUNNEL_DIAMETER/2,
        tunnel_length,
        FreeCAD.Vector(entry_x - entry_tangent.x * tunnel_length,
                      entry_y - entry_tangent.y * tunnel_length,
                      entry_z - entry_tangent.z * tunnel_length),
        entry_tangent
    )
    
    exit_angle = 2 * math.pi * NUM_LOOPS
    exit_x = SPIRAL_RADIUS * math.cos(exit_angle)
    exit_y = SPIRAL_RADIUS * math.sin(exit_angle)
    exit_z = z_offset + spiral_height
    
    # Exit tangent direction
    exit_tangent_x = -math.sin(exit_angle)
    exit_tangent_y = math.cos(exit_angle)
    exit_tangent_z = pitch / (2 * math.pi * SPIRAL_RADIUS)
    exit_tangent = FreeCAD.Vector(exit_tangent_x, exit_tangent_y, exit_tangent_z).normalize()
    
    exit_tunnel = Part.makeCylinder(
        TUNNEL_DIAMETER/2,
        tunnel_length,
        FreeCAD.Vector(exit_x, exit_y, exit_z),
        exit_tangent
    )
    
    # Combine all tunnels
    tunnel_system = tunnel_shape.fuse([entry_tunnel, exit_tunnel])
    
    # Cut tunnel system from cylinder
    final_shape = main_shape.cut(tunnel_system)
    
    final_obj = doc.addObject("Part::Feature", "FilamentDryerModule")
    final_obj.Shape = final_shape
    
    doc.recompute()
    
    print("✓ Created module using Part workbench sweep method")
    
    return final_obj

# Main execution
if __name__ == "__main__":
    try:
        # Try PartDesign method first
        module = create_spiral_tunnel_module()
    except Exception as e:
        print(f"\nPartDesign method failed: {e}")
        try:
            # Fall back to Part workbench method
            module = create_spiral_tunnel_part_method()
        except Exception as e2:
            print(f"Part method also failed: {e2}")
            module = None
    
    if module:
        print("\n✅ Success! Filament dryer module created.")
    else:
        print("\n❌ Failed to create module.")